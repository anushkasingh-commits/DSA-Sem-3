      "index": "aN",
      "fontSize": 16,
      "fontFamily": 2,
      "text": "auto ok = [&](long long m) { return m * m <= x; };\nwhile (lo < hi) {\n    long long mid = (lo + hi + 1) / 2;\n    if (ok(mid)) lo = mid; else hi = mid - 1;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "auto ok = [&](long long m) { return m * m <= x; };\nwhile (lo < hi) {\n    long long mid = (lo + hi + 1) / 2;\n    if (ok(mid)) lo = mid; else hi = mid - 1;\n}",
      "lineHeight": 1.25,
      "autoResize": true
    },
