      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "auto ok = [&](long long m) {\n    return m * m <= x;\n};\nwhile (lo < hi) {\n    long long mid = (lo + hi + 1) / 2;\n    if (ok(mid)) lo = mid; else hi = mid - 1;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "auto ok = [&](long long m) {\n    return m * m <= x;\n};\nwhile (lo < hi) {\n    long long mid = (lo + hi + 1) / 2;\n    if (ok(mid)) lo = mid; else hi = mid - 1;\n}",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0J"
    },
