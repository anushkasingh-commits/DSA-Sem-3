      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 8,
      "text": "auto cmp = [](int a, int b) { return a > b; };\npriority_queue<int, vector<int>, decltype(cmp)> pq(cmp);\npq.push(5); pq.push(1);\ncout << pq.top();     // 1",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "auto cmp = [](int a, int b) { return a > b; };\npriority_queue<int, vector<int>, decltype(cmp)> pq(cmp);\npq.push(5); pq.push(1);\ncout << pq.top();     // 1",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0D"
