      "index": "a5",
      "fontSize": 16,
      "fontFamily": 8,
      "text": "Only the position of the visit changes.\nLeft and right recursion stay put.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only the position of the visit changes.\nLeft and right recursion stay put.",
      "lineHeight": 1.25,
