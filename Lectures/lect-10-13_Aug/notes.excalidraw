    },
    {
      "id": "W8c7THLrJ-9hliE0jZ3uS",
      "type": "text",
      "x": 168.43442164496162,
      "y": -358.05463644376607,
      "width": 369.5994873046875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
