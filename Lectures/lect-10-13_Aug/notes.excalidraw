      "locked": false,
      "index": "aO",
      "fontSize": 16,
      "fontFamily": 8,
      "text": "auto dfs = [&](auto &self, Node *r) -> void {\n    if (!r) return;\n    self(self, r->left);\n    self(self, r->right);\n};\ndfs(dfs, root);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "auto dfs = [&](auto &self, Node *r) -> void {\n    if (!r) return;\n    self(self, r->left);\n    self(self, r->right);\n};\ndfs(dfs, root);",
      "lineHeight": 1.25,
      "autoResize": true
    },
